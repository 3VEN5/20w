# 复制成 /srv/app.env，权限设成 600。不要提交到 GitHub。
APP_DB=/srv/data/app.db
SECURE_COOKIE=1
# AI 整理（可选）。不填就只能手动添加事项。
# AI_API_KEY=sk-...
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-chat
# 图片识别（可选）。DeepSeek 不能看图，用通义千问的看图模型；填了 AI_VISION_MODEL 才开通。
# AI_VISION_MODEL=qwen-vl-max
# AI_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_VISION_API_KEY=sk-...
